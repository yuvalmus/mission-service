NODE_ENV=development
PORT=5000
SERVICE_NAME=mission-service
LOG_LEVEL=info

# Ground -> MongoDB | Air -> Redis | Edge -> PostgreSQL (mesh)
STATION=Air

# --- Ground ---
MONGO_ADDRESS= <ADDRESS>
MONGO_USERNAME= <USERNAME>
MONGO_PASSWORD= <PASSWORD>

# --- Air ---
REDIS_HOST=localhost
REDIS_PORT=<REDIS_PORT>

# --- Edge: local database -------------------------------------------------
# The service always talks to the database on its own machine. It never reads
# or writes the peer's database directly; replication does that in the
# background, which is what lets a station keep working while alone.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mesh
POSTGRES_PASSWORD=mesh_pass
POSTGRES_DB=meshdb
POSTGRES_POOL_MAX=5

# --- Edge: mesh identity --------------------------------------------------
# NODE_NAME is stamped on every row as origin_node and decides which changes
# this station publishes to NATS.
NODE_NAME=station-a
PEER_NODE_NAME=station-b

# Reached only by the pglogical replication worker. Leave PEER_POSTGRES_HOST
# unset to run a single station with no replication.
PEER_POSTGRES_HOST=station-b-postgres
PEER_POSTGRES_PORT=5432

# Change sequences are interleaved so two stations writing while disconnected
# never assign the same number: station i emits i, i+N, i+2N, ...
# Give each station a distinct index; N is the number of stations.
MESH_NODE_INDEX=1
MESH_NODE_COUNT=2

# --- Edge: event distribution --------------------------------------------
NATS_URL=nats://localhost:4222

# --- Edge: lifecycle ------------------------------------------------------
# How long a tombstone is kept before the row is physically removed. It must
# outlast the longest disconnection you expect, or a station that was offline
# would never learn the entity was deleted.
TOMBSTONE_RETENTION_MINUTES=10
GC_INTERVAL_SECONDS=120
ROUTE_BACKUP_LIMIT=10
